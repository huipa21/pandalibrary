{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.2.2",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && svelte-kit sync",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "2.29.3",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.6",
		"fake-indexeddb": "6.2.4",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "4.1.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"clsx": "2.1.1",
		"dompurify": "3.4.17",
		"foliate-js": "1.0.1",
		"marked": "18.1.2",
		"pdfjs-dist": "6.5.438",
		"tailwind-merge": "3.7.0",
		"uuid": "14.0.3"
	}
}
