# PandaLibrary — docker compose environment.
# Copy to `.env` (same directory) and adjust. Loaded automatically by `docker compose`.
# Never commit the real `.env`; only this template.

# Public HTTPS origin the app is served from (required).
PANDA_BASE_URL=https://books.example.org

# Optional: comma-separated CIDRs of trusted reverse proxies.
# Leave empty unless you need forwarded client IPs or request schemes.
PANDA_TRUSTED_PROXIES=
